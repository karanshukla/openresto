<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The implicit usings Microsoft.NET.Sdk.Web adds, which this code was written against
       while it lived in the web project. -->
  <ItemGroup>
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="csulpizi.CustomAccessibility" Version="1.0.3" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- The API registers these internal types with DI in ServiceCollectionExtensions. -->
  <ItemGroup>
    <InternalsVisibleTo Include="OpenRestoApi" />
    <InternalsVisibleTo Include="OpenRestoApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRestoApi.Core\OpenRestoApi.Core.csproj" />
  </ItemGroup>

</Project>
