{
  "name": "openresto-frontend",
  "main": "expo-router/entry",
  "version": "2.7.1",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:staged": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:android": "jest -c jest.config.android.js",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:extensive": "playwright test --grep-invert @smoke",
    "test:e2e:ui": "playwright test --ui",
    "routes:check": "node ./scripts/check-routes.mjs",
    "routes:update": "node ./scripts/check-routes.mjs --update",
    "native:init": "node ./scripts/native-init.mjs",
    "native:go": "node ./scripts/expo-go.mjs",
    "check": "npm run format:check && npm run lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~58.0.32",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "i18next": "^27.1.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.2",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint-plugin-expo": "^1.1.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~7.0.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest-mocks/styleMock.js",
      "^@/components/common/AnimatedAccordion$": "<rootDir>/jest-mocks/AnimatedAccordion.js",
      "^@/services/storage$": "<rootDir>/services/storage.ts",
      "^@/services/pushRegistration$": "<rootDir>/services/pushRegistration.ts",
      "^@/services/holdExpiryNotice$": "<rootDir>/services/holdExpiryNotice.ts",
      "^@/services/quickActions$": "<rootDir>/services/quickActions.ts",
      "^@/components/booking/BookingSheetHost$": "<rootDir>/components/booking/BookingSheetHost.tsx",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "api/**/*.{ts,tsx}",
      "context/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "utils/**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!hooks/use-color-scheme.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/e2e/"
    ],
    "transform": {
      "\\.mjs$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  },
  "overrides": {
    "react-test-renderer": "19.3.0",
    "uuid": ">=14.0.0",
    "shell-quote": ">=1.8.4",
    "brace-expansion": ">=5.0.9",
    "js-yaml": ">=5.2.2",
    "nanoid": "^3.3.17",
    "decode-uri-component": ">=0.5.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
