{
  "name": "openresto-frontend",
  "main": "expo-router/entry",
  "version": "1.9.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:staged": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:extensive": "playwright test --grep-invert @smoke",
    "test:e2e:ui": "playwright test --ui",
    "routes:check": "node ./scripts/check-routes.mjs",
    "routes:update": "node ./scripts/check-routes.mjs --update",
    "native:init": "node ./scripts/native-init.mjs",
    "native:go": "node ./scripts/expo-go.mjs",
    "check": "npm run format:check && npm run lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-sharing": "~57.0.15",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.16",
    "eslint-plugin-expo": "^1.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "oxlint": "^1.73.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest-mocks/styleMock.js",
      "^@/components/common/AnimatedAccordion$": "<rootDir>/jest-mocks/AnimatedAccordion.js",
      "^@/services/storage$": "<rootDir>/services/storage.ts",
      "^@/services/pushRegistration$": "<rootDir>/services/pushRegistration.ts",
      "^@/services/holdExpiryNotice$": "<rootDir>/services/holdExpiryNotice.ts",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "api/**/*.{ts,tsx}",
      "context/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "utils/**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!hooks/use-color-scheme.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/e2e/"
    ],
    "transform": {
      "\\.mjs$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  },
  "overrides": {
    "react-test-renderer": "19.2.3",
    "uuid": ">=14.0.0",
    "shell-quote": ">=1.8.4",
    "brace-expansion": ">=5.0.9",
    "js-yaml": ">=5.2.2",
    "nanoid": "^3.3.17",
    "decode-uri-component": ">=0.5.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "private": true
}
